+/*
+ * d2x-cios-ftp: append the Wii games found on the FTP server (if enabled
+ * in the loader settings) to FullGameList, with partition FTP_PARTITION.
+ * Must run after the local partitions have been read: a game that is
+ * also on a local drive is skipped, the local copy is faster.
+ * Returns the number of games added, or <= 0.
+ */
+int GameList::InternalReadFtpList()
+{
+	std::vector<struct discHdr> FtpList;
+
+	int ret = FtpGames_ReadList(FtpList);
+	if (ret <= 0)
+		return ret;
+
+	//! Games on a local drive are preferred
+	for (u32 i = 0; i < FtpList.size(); i++)
+	{
+		for (u32 j = 0; j < FullGameList.size(); j++)
+		{
+			if (strncasecmp((const char *)FtpList[i].id, (const char *)FullGameList[j].id, 6) == 0)
+			{
+				FtpList.erase(FtpList.begin() + i);
+				--i;
+				break;
+			}
+		}
+	}
+
+	FullGameList.insert(FullGameList.end(), FtpList.begin(), FtpList.end());
+	GamePartitionList.resize(FullGameList.size(), FTP_PARTITION);
+
+	return FtpList.size();
+}
