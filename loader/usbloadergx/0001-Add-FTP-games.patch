+// net (d2x-cios-ftp)
+
+/*
+ * Set the network (FTP) disc mode of d2x-cios-ftp: netconfig points to a
+ * struct netConfig (264 bytes, see FtpGames.cpp). Same calling convention
+ * as WDVD_SetFragList(): the DI driver returns 1 when the command ran,
+ * the plugin result is in outbuf[0]. Returns 0 on success.
+ */
+
+s32 WDVD_SetNetMode(void *netconfig, int size)
+{
+	if (_di_fd < 0)
+		return _di_fd;
+
+	s32 ret;
+
+	memset(inbuf, 0, sizeof(inbuf));
+	memset(outbuf, 0, sizeof(outbuf));
+
+	/* Set NET mode */
+	inbuf[0] = IOCTL_DI_SETNET << 24;
+	inbuf[1] = (u32)netconfig;
+	inbuf[2] = size;
+
+	DCFlushRange(netconfig, size);
+	ret = IOS_Ioctl(_di_fd, IOCTL_DI_SETNET, inbuf, sizeof(inbuf), outbuf, sizeof(outbuf));
+
+	if (ret < 0)
+		return ret;
+
+	if (ret != 1)
+		return -ret;
+
+	/* Plugin result (0 = ok) */
+	return outbuf[0];
+}
